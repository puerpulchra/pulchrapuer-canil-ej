{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "files": {
    "include": ["src/**/*.js", "scripts/**/*.mjs", "tests/**/*.{mjs,ts}", "*.ts"],
    "ignore": ["dist", "coverage", "node_modules"]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "linter": { "enabled": true, "rules": { "recommended": true } },
  "overrides": [
    {
      "include": ["src/logic.js", "src/observability.js"],
      "formatter": { "enabled": false },
      "linter": {
        "rules": {
          "style": { "noVar": "off", "useTemplate": "off" },
          "complexity": { "useArrowFunction": "off", "useOptionalChain": "off", "noForEach": "off" },
          "correctness": { "noInnerDeclarations": "off" }
        }
      }
    }
  ]
}
